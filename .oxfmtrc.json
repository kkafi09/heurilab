{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "sources/**",
    "PLAN.md",
    "bun.lock",
    "dist/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
